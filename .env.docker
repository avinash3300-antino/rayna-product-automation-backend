# ============================================
#  FILL THIS FILE AND RENAME TO .env ON EC2
# ============================================

# ── EC2 ─────────────────────────────────────
EC2_PUBLIC_IP=YOUR_EC2_PUBLIC_IP_HERE

# ── PostgreSQL ──────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Auth ────────────────────────────────────
SECRET_KEY=CHANGE_ME_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Frontend Auth ───────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_ANOTHER_RANDOM_SECRET

# ── Frontend Path (on EC2) ──────────────────
FRONTEND_PATH=../frontend

# ── Anthropic ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Ahrefs ──────────────────────────────────
AHREFS_API_TOKEN=

# ── Booking.com ─────────────────────────────
BOOKING_COM_AFFILIATE_ID=
BOOKING_COM_API_KEY=

# ── Viator ──────────────────────────────────
VIATOR_API_KEY=

# ── GetYourGuide ────────────────────────────
GETYOURGUIDE_API_KEY=

# ── Apify ───────────────────────────────────
APIFY_API_TOKEN=

# ── Cloudinary ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── App ─────────────────────────────────────
ENVIRONMENT=production
